{
  "expo": {
    "name": "connectcar",
    "slug": "connectcar",
    "version": "1.0.0",
    "scheme": "connectcar",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./assets/Logo/logo-removebg-preview.png/",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/Logo/Logo/logo-removebg-preview.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/Logo/Logo/logo-removebg-preview.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.github.josiasdev.connectcar",
      
    }
  }
}
